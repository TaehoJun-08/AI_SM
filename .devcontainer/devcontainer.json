{
  "name": "AI Sponsorship Matchmaker",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && python seed_demo.py",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": { "label": "App", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
